+package m3g.viewer;
+import javax.microedition.m3g.*;
+import m3g.render.MeshMorph;
+public final class MorphDump {
+	public static void main(String[] a) throws Exception {
+		Object3D[] roots = Loader.load(a[0]);
+		World w = null; for (Object3D o : roots) if (o instanceof World) w = (World) o;
+		w.setWorldTime(Integer.parseInt(a[1])); w.postFrame();
+		walk(w);
+	}
+	static void walk(Node n) {
+		if (n instanceof MorphingMesh) {
+			VertexBuffer vb = MeshMorph.getViewInstance().getMorphedVertexBuffer((Mesh) n);
+			float[] sb = new float[4];
+			VertexArray p = vb.getPositions(sb);
+			short[] s = p.getShortValues();
+			long h = 1125899906842597L; for (short v : s) h = 31*h + v;
+			System.out.println("pos hash " + h + " count " + s.length + " sb " + java.util.Arrays.toString(sb));
+			VertexArray nn = vb.getNormals(); short[] ns = nn.getShortValues(); h = 1125899906842597L; for (short v : ns) h = 31*h + v; System.out.println("norm hash " + h);
+			float[] sb2 = new float[4]; VertexArray u = vb.getTexCoords(0, sb2); short[] us = u.getShortValues(); h = 1125899906842597L; for (short v : us) h = 31*h + v; System.out.println("uv hash " + h + " sb " + java.util.Arrays.toString(sb2));
+			StringBuilder sbd = new StringBuilder(); for (int i = 0; i < 12; i++) sbd.append(s[i]).append(' '); System.out.println("first " + sbd);
+		}
+		if (n instanceof Group) for (int i = 0; i < ((Group) n).getChildCount(); i++) walk(((Group) n).getChild(i));
+	}
+}
