+		if (o instanceof World) { World w=(World)o; sb.append(" cam=").append(w.getActiveCamera()!=null).append(" bg=").append(w.getBackground()!=null); }
+		sb.append(" tracks=").append(o.getAnimationTrackCount());
+		System.out.println(sb);
+		Object3D[] refs = new Object3D[o.getReferences(null)];
+		o.getReferences(refs);
+		for (Object3D r : refs) walk(r, d + 1);
+	}
+}
