+			for (int i=0;i<m.getSubmeshCount();i++) { Appearance ap = m.getAppearance(i); sb.append("\n").append("  ".repeat(d+1)).append("sub").append(i).append(" strips=").append(((TriangleStripArray)m.getIndexBuffer(i)).getStripCount()).append(" ap=").append(ap==null?"null":"layer"+ap.getLayer()+" cm="+(ap.getCompositingMode()!=null)+" fog="+(ap.getFog()!=null)+" pm="+(ap.getPolygonMode()!=null)+" mat="+(ap.getMaterial()!=null)+" tex0="+(ap.getTexture(0)!=null)); }
+		}
+		if (o instanceof PolygonMode) { PolygonMode p=(PolygonMode)o; sb.append(" cull=").append(p.getCulling()).append(" shade=").append(p.getShading()).append(" wind=").append(p.getWinding()).append(" 2side=").append(p.isTwoSidedLightingEnabled()).append(" local=").append(p.isLocalCameraLightingEnabled()).append(" persp=").append(p.isPerspectiveCorrectionEnabled()); }
+		if (o instanceof CompositingMode) { CompositingMode c=(CompositingMode)o; sb.append(" blend=").append(c.getBlending()).append(" dt=").append(c.isDepthTestEnabled()).append(" dw=").append(c.isDepthWriteEnabled()).append(" cw=").append(c.isColorWriteEnabled()).append(" aw=").append(c.isAlphaWriteEnabled()).append(" thr=").append(c.getAlphaThreshold()).append(" off=").append(c.getDepthOffsetFactor()).append(",").append(c.getDepthOffsetUnits()); }
+		if (o instanceof Material) { Material c=(Material)o; sb.append(" amb=").append(Integer.toHexString(c.getColor(1024))).append(" dif=").append(Integer.toHexString(c.getColor(2048))).append(" emi=").append(Integer.toHexString(c.getColor(4096))).append(" spe=").append(Integer.toHexString(c.getColor(8192))).append(" shin=").append(c.getShininess()).append(" vct=").append(c.isVertexColorTrackingEnabled()); }
+		if (o instanceof Texture2D) { Texture2D t=(Texture2D)o; sb.append(" blend=").append(t.getBlending()).append(" wrap=").append(t.getWrappingS()).append(",").append(t.getWrappingT()).append(" filt=").append(t.getImageFilter()).append(",").append(t.getLevelFilter()).append(" bc=").append(Integer.toHexString(t.getBlendColor())); }
+		if (o instanceof Image2D) { Image2D i=(Image2D)o; sb.append(" fmt=").append(i.getFormat()).append(" ").append(i.getWidth()).append("x").append(i.getHeight()); }
+		if (o instanceof Background) { Background b=(Background)o; sb.append(" color=").append(Integer.toHexString(b.getColor())).append(" img=").append(b.getImage()!=null).append(" cc=").append(b.isColorClearEnabled()).append(" dc=").append(b.isDepthClearEnabled()); }
+		if (o instanceof Fog) { Fog f=(Fog)o; sb.append(" mode=").append(f.getMode()).append(" color=").append(Integer.toHexString(f.getColor())).append(" near=").append(f.getNearDistance()).append(" far=").append(f.getFarDistance()).append(" dens=").append(f.getDensity()); }
