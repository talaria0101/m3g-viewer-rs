diff -ruN '--exclude=build' '--exclude=lib' '--exclude=assets' a/src/m3g/viewer/StateDump.java b/src/m3g/viewer/StateDump.java
--- a/src/m3g/viewer/StateDump.java	1970-01-01 00:00:00.000000000 +0000
+++ b/src/m3g/viewer/StateDump.java	2026-10-17 09:32:47.230582659 +0000
@@ -0,0 +1,30 @@
+package m3g.viewer;
+import javax.microedition.m3g.*;
+import java.util.*;
+public final class StateDump {
+	static String hex(float v) { return Integer.toHexString(Float.floatToRawIntBits(v)); }
+	public static void main(String[] a) throws Exception {
+		for (String file : a) {
+			Object3D[] roots = Loader.load(file);
+			World w = null; for (Object3D o : roots) if (o instanceof World) w = (World) o;
+			float[] b = Main.Scene.boundsOf(w);
+			StringBuilder sb = new StringBuilder("bounds");
+			for (float v : b) sb.append(' ').append(hex(v));
+			System.out.println(file.substring(file.lastIndexOf('/') + 1) + " " + sb);
+			for (int t : new int[]{0, 16, 250, 777, 1600, 99999}) {
+				w.setWorldTime(t); w.postFrame();
+				StringBuilder out = new StringBuilder();
+				walk(w, out);
+				System.out.println("t=" + t + out);
+			}
+		}
+	}
+	static void walk(Node n, StringBuilder out) {
+		Transform tr = new Transform(); n.getCompositeTransform(tr); float[] m = new float[16]; tr.get(m);
+		out.append(" |");
+		for (float v : m) out.append(' ').append(hex(v));
+		out.append(" a=").append(hex(n.getAlphaFactor())).append(" r=").append(n.isRenderingEnabled());
+		if (n instanceof MorphingMesh) { float[] ws = new float[((MorphingMesh) n).getMorphTargetCount()]; ((MorphingMesh) n).getWeights(ws); for (float v : ws) out.append(" w=").append(hex(v)); out.append(" bw=").append(hex(((MorphingMesh) n).getBaseWeight())); }
+		if (n instanceof Group) for (int i = 0; i < ((Group) n).getChildCount(); i++) walk(((Group) n).getChild(i), out);
+	}
+}
