+		sb.append(o.getClass().getSimpleName()).append(first ? "" : " (seen)");
+		if (!first) { System.out.println(sb); return; }
+		if (o instanceof Transformable) {
+			float[] t = new float[4], s = new float[4], r = new float[4];
